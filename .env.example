# Copy this file to .env and replace the placeholder values.
# Never commit your real .env file.

PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string (the app always uses the database "comp3123_assignment1")
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Use a long random string, e.g. generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# Strict limit for /signup and /login
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MIN=15

# General limit for all /api routes
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MIN=15
